<div class="customer reset-password flex flex-col items-center p-4 md:p-6">
  <div class="max-w-screen-sm w-full scroll-mt-[350px]">

    {% assign resetPasswordString = 'customer.reset_password.title' | t %}
    {% render 'armament-heading' with tag, tag: 'h2', heading_content: resetPasswordString, heading_type: 'heading-2', data_aid: "reset-acc-password-heading", classes: 'text-center mb-4 md:mb-6' %}

    <p class="text-center text-body mb-2 md:mb-3">{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password' -%}

      {% if form.errors %}
        <form-errors
          data-form-type="reset_customer_password"
          data-form-name="recover password"
          data-errors='{{ form.errors | default_errors }}'></form-errors>
        <safe-load-scripts>
          <script
            src="{{ 'component-form-errors.min.js' | asset_url }}"
            defer="defer"
            type="module"></script>
        </safe-load-scripts>
      {% endif %}

      {% capture password_attr %}
                autocomplete="new-password"
                {% if form.errors contains 'password' %}
                    aria-invalid="true"
                {% endif %}
            {% endcapture %}
      {% render 'armament-input' with type, type: "password", has_label: true, animate_label: true, label_text: "New password", id: "password", placeholder: "password", name: "customer[password]", required: true, attributes: password_attr, container_classes: 'mb-3 md:mb-4 text-body', classes: 'w-full' %}

      {% capture confirm_attr %}
                autocomplete="new-password"
                {% if form.errors contains 'password_confirmation' %}
                    aria-invalid="true"
                    aria-describedby="password_confirmation-error"
                {% endif %}
            {% endcapture %}
      {% render 'armament-input' with type, type: "password", has_label: true, animate_label: true, label_text: "Confirm new password", id: "password_confirmation", placeholder: "Password Confirmation", name: "customer[password_confirmation]", required: true, attributes: confirm_attr, container_classes: 'mb-3 md:mb-4 text-body', classes: 'w-full' %}

      {% assign submitString = 'customer.recover_password.submit' | t %}
      {% render 'armament-button' with content, content: submitString, style: 'filled', classes: 'my-3 md:my-4 w-full', data_aid: 'reset-password-btn' %}

    {%- endform -%}

  </div>
</div>{%- comment -%}

